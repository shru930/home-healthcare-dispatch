<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_pharmacy_prescription_fulfillment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
<bpmn:process id="pharmacy-prescription-fulfillment" name="Pharmacy Prescription Fulfillment" isExecutable="true"><bpmn:documentation>Reusable child process called once per prescription: verify, reserve stock (primary or partner pharmacy), dispatch a courier, wait for the delivery confirmation message and notify the family by SMS. Returns fulfillmentStatus, deliveryRef and fulfillmentNote.</bpmn:documentation>
<bpmn:startEvent id="Start_Rx" name="Prescription received"><bpmn:outgoing>Flow_Start_Rx_Task_VerifyRx</bpmn:outgoing></bpmn:startEvent>
<bpmn:serviceTask id="Task_VerifyRx" name="Verify prescription"><bpmn:extensionElements><zeebe:taskDefinition type="rx.verify-prescription" retries="3" /><zeebe:ioMapping><zeebe:input source="=prescription" target="prescription" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Start_Rx_Task_VerifyRx</bpmn:incoming><bpmn:outgoing>Flow_Task_VerifyRx_Gw_RxValid</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="Gw_RxValid" name="Prescription valid?"><bpmn:incoming>Flow_Task_VerifyRx_Gw_RxValid</bpmn:incoming><bpmn:outgoing>Flow_Gw_RxValid_Task_CheckStock</bpmn:outgoing><bpmn:outgoing>Flow_Gw_RxValid_Task_NotifyRejection</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="Task_NotifyRejection" name="Notify prescribing doctor"><bpmn:extensionElements><zeebe:taskDefinition type="rx.notify-rejection" retries="3" /><zeebe:ioMapping><zeebe:input source="=patientId" target="patientId" /><zeebe:input source="=prescription" target="prescription" /><zeebe:input source="=rxRejectionReason" target="rxRejectionReason" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Gw_RxValid_Task_NotifyRejection</bpmn:incoming><bpmn:outgoing>Flow_Task_NotifyRejection_End_Rejected</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="End_Rejected" name="Prescription rejected"><bpmn:incoming>Flow_Task_NotifyRejection_End_Rejected</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="Task_CheckStock" name="Check and reserve stock"><bpmn:extensionElements><zeebe:taskDefinition type="rx.check-stock" retries="3" /><zeebe:ioMapping><zeebe:input source="=prescription" target="prescription" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Gw_RxValid_Task_CheckStock</bpmn:incoming><bpmn:outgoing>Flow_Task_CheckStock_Gw_Stock</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="Gw_Stock" name="In stock?"><bpmn:incoming>Flow_Task_CheckStock_Gw_Stock</bpmn:incoming><bpmn:outgoing>Flow_Gw_Stock_Gw_StockJoin</bpmn:outgoing><bpmn:outgoing>Flow_Gw_Stock_Task_SourcePartner</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="Task_SourcePartner" name="Source from partner pharmacy"><bpmn:extensionElements><zeebe:taskDefinition type="rx.source-partner" retries="3" /><zeebe:ioMapping><zeebe:input source="=prescription" target="prescription" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Gw_Stock_Task_SourcePartner</bpmn:incoming><bpmn:outgoing>Flow_Task_SourcePartner_Gw_Partner</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="Gw_Partner" name="Partner has it?"><bpmn:incoming>Flow_Task_SourcePartner_Gw_Partner</bpmn:incoming><bpmn:outgoing>Flow_Gw_Partner_Gw_StockJoin</bpmn:outgoing><bpmn:outgoing>Flow_Gw_Partner_Task_MarkUnavailable</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="Task_MarkUnavailable" name="Mark unavailable and alert coordinator"><bpmn:extensionElements><zeebe:taskDefinition type="rx.mark-unavailable" retries="3" /><zeebe:ioMapping><zeebe:input source="=patientId" target="patientId" /><zeebe:input source="=prescription" target="prescription" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Gw_Partner_Task_MarkUnavailable</bpmn:incoming><bpmn:outgoing>Flow_Task_MarkUnavailable_End_Unavailable</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="End_Unavailable" name="Medicine unavailable"><bpmn:incoming>Flow_Task_MarkUnavailable_End_Unavailable</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="Gw_StockJoin" name=""><bpmn:incoming>Flow_Gw_Stock_Gw_StockJoin</bpmn:incoming><bpmn:incoming>Flow_Gw_Partner_Gw_StockJoin</bpmn:incoming><bpmn:outgoing>Flow_Gw_StockJoin_Task_Dispatch</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="Task_Dispatch" name="Dispense and book courier"><bpmn:extensionElements><zeebe:taskDefinition type="rx.dispatch-delivery" retries="3" /><zeebe:ioMapping><zeebe:input source="=prescription" target="prescription" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Gw_StockJoin_Task_Dispatch</bpmn:incoming><bpmn:outgoing>Flow_Task_Dispatch_Task_AwaitDelivery</bpmn:outgoing></bpmn:serviceTask>
<bpmn:boundaryEvent id="Err_Courier" name="No courier" cancelActivity="true" attachedToRef="Task_Dispatch"><bpmn:outgoing>Flow_Err_Courier_Task_Reschedule</bpmn:outgoing><bpmn:errorEventDefinition errorRef="Error_COURIER_UNAVAILABLE" /></bpmn:boundaryEvent>
<bpmn:serviceTask id="Task_Reschedule" name="Reschedule delivery"><bpmn:extensionElements><zeebe:taskDefinition type="rx.reschedule-delivery" retries="3" /><zeebe:ioMapping><zeebe:input source="=patientId" target="patientId" /><zeebe:input source="=prescription" target="prescription" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Err_Courier_Task_Reschedule</bpmn:incoming><bpmn:outgoing>Flow_Task_Reschedule_End_Delayed</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="End_Delayed" name="Delivery delayed"><bpmn:incoming>Flow_Task_Reschedule_End_Delayed</bpmn:incoming></bpmn:endEvent>
<bpmn:receiveTask id="Task_AwaitDelivery" name="Await delivery confirmation" messageRef="Message_MedicationDelivered"><bpmn:extensionElements><zeebe:ioMapping><zeebe:input source="=deliveryRef" target="deliveryRef" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Task_Dispatch_Task_AwaitDelivery</bpmn:incoming><bpmn:outgoing>Flow_Task_AwaitDelivery_Task_RecordDelivery</bpmn:outgoing></bpmn:receiveTask>
<bpmn:boundaryEvent id="Timer_DeliveryReminder" name="Taking longer than expected" cancelActivity="false" attachedToRef="Task_AwaitDelivery"><bpmn:outgoing>Flow_Timer_DeliveryReminder_Task_SmsDelayed</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=deliveryReminder</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:boundaryEvent id="Timer_DeliveryTimeout" name="Delivery deadline passed" cancelActivity="true" attachedToRef="Task_AwaitDelivery"><bpmn:outgoing>Flow_Timer_DeliveryTimeout_Task_MarkFailed</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=deliveryTimeout</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:serviceTask id="Task_SmsDelayed" name="SMS family: delivery delayed" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTgiIGhlaWdodD0iMTgiIHZpZXdCb3g9IjAgMCAxOCAxOCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48Y2lyY2xlIGN4PSI5IiBjeT0iOSIgcj0iOCIgZmlsbD0iIzUwNTU2MiIvPjwvc3ZnPg=="><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="bearer" target="authentication.type" /><zeebe:input source="{{secrets.SMS_API_KEY}}" target="authentication.token" /><zeebe:input source="POST" target="method" /><zeebe:input source="{{secrets.SMS_GATEWAY_URL}}" target="url" /><zeebe:input source="={&quot;Content-Type&quot;: &quot;application/json&quot;}" target="headers" /><zeebe:input source="={to: familyPhone, category: &quot;DELIVERY_DELAYED&quot;, message: &quot;Delivery of &quot; + prescription.medication + &quot; (&quot; + deliveryRef + &quot;) for &quot; + patientName + &quot; is taking longer than expected. City Home Care&quot;}" target="body" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value="={delayNoticeSid: response.body.sid}" /><zeebe:header key="retryBackoff" value="PT5S" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_Timer_DeliveryReminder_Task_SmsDelayed</bpmn:incoming><bpmn:outgoing>Flow_Task_SmsDelayed_End_DelayNotified</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="End_DelayNotified" name="Family informed"><bpmn:incoming>Flow_Task_SmsDelayed_End_DelayNotified</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="Task_MarkFailed" name="Mark delivery failed"><bpmn:extensionElements><zeebe:taskDefinition type="rx.mark-delivery-failed" retries="3" /><zeebe:ioMapping><zeebe:input source="=patientId" target="patientId" /><zeebe:input source="=deliveryRef" target="deliveryRef" /><zeebe:input source="=prescription" target="prescription" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Timer_DeliveryTimeout_Task_MarkFailed</bpmn:incoming><bpmn:outgoing>Flow_Task_MarkFailed_End_Failed</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="End_Failed" name="Delivery failed"><bpmn:incoming>Flow_Task_MarkFailed_End_Failed</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="Task_RecordDelivery" name="Record delivery"><bpmn:extensionElements><zeebe:taskDefinition type="rx.record-delivery" retries="3" /><zeebe:ioMapping><zeebe:input source="=deliveryRef" target="deliveryRef" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Task_AwaitDelivery_Task_RecordDelivery</bpmn:incoming><bpmn:outgoing>Flow_Task_RecordDelivery_Task_SmsDelivered</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="Task_SmsDelivered" name="SMS family: medicine delivered" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTgiIGhlaWdodD0iMTgiIHZpZXdCb3g9IjAgMCAxOCAxOCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48Y2lyY2xlIGN4PSI5IiBjeT0iOSIgcj0iOCIgZmlsbD0iIzUwNTU2MiIvPjwvc3ZnPg=="><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="bearer" target="authentication.type" /><zeebe:input source="{{secrets.SMS_API_KEY}}" target="authentication.token" /><zeebe:input source="POST" target="method" /><zeebe:input source="{{secrets.SMS_GATEWAY_URL}}" target="url" /><zeebe:input source="={&quot;Content-Type&quot;: &quot;application/json&quot;}" target="headers" /><zeebe:input source="={to: familyPhone, category: &quot;MEDICATION_DELIVERED&quot;, message: prescription.medication + &quot; for &quot; + patientName + &quot; has been delivered (&quot; + deliveryRef + &quot;). City Home Care&quot;}" target="body" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value="={deliveryNoticeSid: response.body.sid}" /><zeebe:header key="retryBackoff" value="PT5S" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_Task_RecordDelivery_Task_SmsDelivered</bpmn:incoming><bpmn:outgoing>Flow_Task_SmsDelivered_End_Delivered</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="End_Delivered" name="Medicine delivered"><bpmn:incoming>Flow_Task_SmsDelivered_End_Delivered</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_Start_Rx_Task_VerifyRx" name="" sourceRef="Start_Rx" targetRef="Task_VerifyRx"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Task_VerifyRx_Gw_RxValid" name="" sourceRef="Task_VerifyRx" targetRef="Gw_RxValid"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Gw_RxValid_Task_CheckStock" name="Valid" sourceRef="Gw_RxValid" targetRef="Task_CheckStock"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=rxValid = true</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Gw_RxValid_Task_NotifyRejection" name="Invalid" sourceRef="Gw_RxValid" targetRef="Task_NotifyRejection"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=rxValid = false</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Task_NotifyRejection_End_Rejected" name="" sourceRef="Task_NotifyRejection" targetRef="End_Rejected"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Task_CheckStock_Gw_Stock" name="" sourceRef="Task_CheckStock" targetRef="Gw_Stock"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Gw_Stock_Gw_StockJoin" name="In stock" sourceRef="Gw_Stock" targetRef="Gw_StockJoin"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=stockStatus = &quot;IN_STOCK&quot;</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Gw_Stock_Task_SourcePartner" name="Out of stock" sourceRef="Gw_Stock" targetRef="Task_SourcePartner"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=stockStatus = &quot;OUT_OF_STOCK&quot;</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Task_SourcePartner_Gw_Partner" name="" sourceRef="Task_SourcePartner" targetRef="Gw_Partner"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Gw_Partner_Gw_StockJoin" name="Yes" sourceRef="Gw_Partner" targetRef="Gw_StockJoin"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=partnerFound = true</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Gw_Partner_Task_MarkUnavailable" name="No" sourceRef="Gw_Partner" targetRef="Task_MarkUnavailable"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=partnerFound = false</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Task_MarkUnavailable_End_Unavailable" name="" sourceRef="Task_MarkUnavailable" targetRef="End_Unavailable"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Gw_StockJoin_Task_Dispatch" name="" sourceRef="Gw_StockJoin" targetRef="Task_Dispatch"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Task_Dispatch_Task_AwaitDelivery" name="" sourceRef="Task_Dispatch" targetRef="Task_AwaitDelivery"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Err_Courier_Task_Reschedule" name="" sourceRef="Err_Courier" targetRef="Task_Reschedule"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Task_Reschedule_End_Delayed" name="" sourceRef="Task_Reschedule" targetRef="End_Delayed"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Task_AwaitDelivery_Task_RecordDelivery" name="" sourceRef="Task_AwaitDelivery" targetRef="Task_RecordDelivery"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Timer_DeliveryReminder_Task_SmsDelayed" name="" sourceRef="Timer_DeliveryReminder" targetRef="Task_SmsDelayed"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Task_SmsDelayed_End_DelayNotified" name="" sourceRef="Task_SmsDelayed" targetRef="End_DelayNotified"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Timer_DeliveryTimeout_Task_MarkFailed" name="" sourceRef="Timer_DeliveryTimeout" targetRef="Task_MarkFailed"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Task_MarkFailed_End_Failed" name="" sourceRef="Task_MarkFailed" targetRef="End_Failed"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Task_RecordDelivery_Task_SmsDelivered" name="" sourceRef="Task_RecordDelivery" targetRef="Task_SmsDelivered"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Task_SmsDelivered_End_Delivered" name="" sourceRef="Task_SmsDelivered" targetRef="End_Delivered"></bpmn:sequenceFlow>
</bpmn:process>
<bpmn:error id="Error_COURIER_UNAVAILABLE" name="Courier unavailable" errorCode="COURIER_UNAVAILABLE" /><bpmn:message id="Message_MedicationDelivered" name="MedicationDelivered"><bpmn:extensionElements><zeebe:subscription correlationKey="=deliveryRef" /></bpmn:extensionElements></bpmn:message>
<bpmndi:BPMNDiagram id="BPMNDiagram_1"><bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="pharmacy-prescription-fulfillment">
<bpmndi:BPMNShape id="Start_Rx_di" bpmnElement="Start_Rx"><dc:Bounds x="82" y="182" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="45" y="222" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Task_VerifyRx_di" bpmnElement="Task_VerifyRx"><dc:Bounds x="160" y="160" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Gw_RxValid_di" bpmnElement="Gw_RxValid" isMarkerVisible="true"><dc:Bounds x="335" y="175" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="290" y="152" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Task_NotifyRejection_di" bpmnElement="Task_NotifyRejection"><dc:Bounds x="300" y="290" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="End_Rejected_di" bpmnElement="End_Rejected"><dc:Bounds x="482" y="312" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="445" y="352" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Task_CheckStock_di" bpmnElement="Task_CheckStock"><dc:Bounds x="420" y="160" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Gw_Stock_di" bpmnElement="Gw_Stock" isMarkerVisible="true"><dc:Bounds x="595" y="175" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="635" y="160" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Task_SourcePartner_di" bpmnElement="Task_SourcePartner"><dc:Bounds x="560" y="290" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Gw_Partner_di" bpmnElement="Gw_Partner" isMarkerVisible="true"><dc:Bounds x="735" y="305" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="775" y="360" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Task_MarkUnavailable_di" bpmnElement="Task_MarkUnavailable"><dc:Bounds x="700" y="430" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="End_Unavailable_di" bpmnElement="End_Unavailable"><dc:Bounds x="882" y="452" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="845" y="492" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Gw_StockJoin_di" bpmnElement="Gw_StockJoin" isMarkerVisible="true"><dc:Bounds x="875" y="175" width="50" height="50" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Task_Dispatch_di" bpmnElement="Task_Dispatch"><dc:Bounds x="970" y="160" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Err_Courier_di" bpmnElement="Err_Courier"><dc:Bounds x="1012" y="222" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1036" y="262" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Task_Reschedule_di" bpmnElement="Task_Reschedule"><dc:Bounds x="970" y="290" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="End_Delayed_di" bpmnElement="End_Delayed"><dc:Bounds x="1012" y="422" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="975" y="462" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Task_AwaitDelivery_di" bpmnElement="Task_AwaitDelivery"><dc:Bounds x="1160" y="160" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Timer_DeliveryReminder_di" bpmnElement="Timer_DeliveryReminder"><dc:Bounds x="1172" y="222" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1196" y="268" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Timer_DeliveryTimeout_di" bpmnElement="Timer_DeliveryTimeout"><dc:Bounds x="1202" y="142" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1228" y="106" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Task_SmsDelayed_di" bpmnElement="Task_SmsDelayed"><dc:Bounds x="1160" y="320" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="End_DelayNotified_di" bpmnElement="End_DelayNotified"><dc:Bounds x="1342" y="342" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1305" y="382" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Task_MarkFailed_di" bpmnElement="Task_MarkFailed"><dc:Bounds x="1160" y="20" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="End_Failed_di" bpmnElement="End_Failed"><dc:Bounds x="1342" y="42" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1305" y="82" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Task_RecordDelivery_di" bpmnElement="Task_RecordDelivery"><dc:Bounds x="1320" y="160" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Task_SmsDelivered_di" bpmnElement="Task_SmsDelivered"><dc:Bounds x="1470" y="160" width="120" height="80" /></bpmndi:BPMNShape>
