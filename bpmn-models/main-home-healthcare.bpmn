<bpmn:serviceTask id="Task_VerifyPlan" name="Verify 7-day plan completion"><bpmn:extensionElements><zeebe:taskDefinition type="hh.verify-plan" retries="3" /><zeebe:ioMapping><zeebe:input source="=workflowId" target="workflowId" /><zeebe:input source="=carePlanId" target="carePlanId" /><zeebe:input source="=visitResults" target="visitResults" /><zeebe:input source="=physioResults" target="physioResults" /><zeebe:input source="=pharmacyResults" target="pharmacyResults" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Gw_Join_Task_VerifyPlan</bpmn:incoming><bpmn:outgoing>Flow_Task_VerifyPlan_Gw_Outcome</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="Gw_Outcome" name="Plan complete? ​"><bpmn:incoming>Flow_Task_VerifyPlan_Gw_Outcome</bpmn:incoming><bpmn:outgoing>Flow_Gw_Outcome_Gw_OutcomeJoin</bpmn:outgoing><bpmn:outgoing>Flow_Gw_Outcome_Task_GapReview</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="Task_GapReview" name="Coordinator reviews gaps"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="gap-review-form" /><zeebe:assignmentDefinition candidateGroups="coordinators" /><zeebe:ioMapping><zeebe:input source="=patientName" target="patientName" /><zeebe:input source="=planSummary" target="planSummary" /><zeebe:input source="=gapCount" target="gapCount" /><zeebe:input source="=visitResults" target="visitResults" /><zeebe:input source="=physioResults" target="physioResults" /><zeebe:input source="=pharmacyResults" target="pharmacyResults" /><zeebe:output source="=gapReviewDecision" target="gapReviewDecision" /><zeebe:output source="=reviewNotes" target="reviewNotes" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Gw_Outcome_Task_GapReview</bpmn:incoming><bpmn:outgoing>Flow_Task_GapReview_Gw_OutcomeJoin</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="Gw_OutcomeJoin" name=""><bpmn:incoming>Flow_Gw_Outcome_Gw_OutcomeJoin</bpmn:incoming><bpmn:incoming>Flow_Task_GapReview_Gw_OutcomeJoin</bpmn:incoming><bpmn:outgoing>Flow_Gw_OutcomeJoin_Task_EmailFinal</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="Task_EmailFinal" name="E-mail family: final status"><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:email:1" retries="3" /><zeebe:ioMapping><zeebe:input source="simple" target="authentication.type" /><zeebe:input source="{{secrets.SMTP_USERNAME}}" target="authentication.username" /><zeebe:input source="{{secrets.SMTP_PASSWORD}}" target="authentication.password" /><zeebe:input source="smtp" target="protocol" /><zeebe:input source="{{secrets.SMTP_HOST}}" target="data.smtpConfig.smtpHost" /><zeebe:input source="{{secrets.SMTP_PORT}}" target="data.smtpConfig.smtpPort" /><zeebe:input source="NONE" target="data.smtpConfig.smtpCryptographicProtocol" /><zeebe:input source="sendEmailSmtp" target="data.smtpActionDiscriminator" /><zeebe:input source="care-team@homecare.example" target="data.smtpAction.from" /><zeebe:input source="=familyEmail" target="data.smtpAction.to" /><zeebe:input source="=&quot;Care plan complete for &quot; + patientName" target="data.smtpAction.subject" /><zeebe:input source="PLAIN" target="data.smtpAction.contentType" /><zeebe:input source="=&quot;Dear &quot; + familyContactName + &quot;,\n\nThe seven-day home-care plan for &quot; + patientName + &quot; has finished.\n&quot; + planSummary + &quot;.\n\nThank you. City Home Care team&quot;" target="data.smtpAction.body" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value="={finalNotificationSent: true}" /><zeebe:header key="errorExpression" value="=if is defined(error) then bpmnError(&quot;NOTIFICATION_FAILED&quot;, &quot;E-mail failed: &quot; + error.message) else null" /><zeebe:header key="retryBackoff" value="PT5S" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_Gw_OutcomeJoin_Task_EmailFinal</bpmn:incoming><bpmn:outgoing>Flow_Task_EmailFinal_Gw_FinalJoin</bpmn:outgoing></bpmn:serviceTask>
<bpmn:boundaryEvent id="Err_EmailFinal" name="E-mail failed ​" cancelActivity="true" attachedToRef="Task_EmailFinal"><bpmn:outgoing>Flow_Err_EmailFinal_Task_RecordFinalNotifyFailure</bpmn:outgoing><bpmn:errorEventDefinition errorRef="Error_NOTIFICATION_FAILED" /></bpmn:boundaryEvent>
<bpmn:serviceTask id="Task_RecordFinalNotifyFailure" name="Record failed notification"><bpmn:extensionElements><zeebe:taskDefinition type="hh.record-notification-failure" retries="3" /><zeebe:ioMapping><zeebe:input source="=patientId" target="patientId" /><zeebe:input source="=familyEmail" target="familyEmail" /><zeebe:input source="=familyPhone" target="familyPhone" /><zeebe:input source="=&quot;FINAL_STATUS&quot;" target="notificationCategory" /><zeebe:input source="=&quot;Final status e-mail failed&quot;" target="notificationError" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Err_EmailFinal_Task_RecordFinalNotifyFailure</bpmn:incoming><bpmn:outgoing>Flow_Task_RecordFinalNotifyFailure_Gw_FinalJoin</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="Gw_FinalJoin" name=""><bpmn:incoming>Flow_Task_EmailFinal_Gw_FinalJoin</bpmn:incoming><bpmn:incoming>Flow_Task_RecordFinalNotifyFailure_Gw_FinalJoin</bpmn:incoming><bpmn:outgoing>Flow_Gw_FinalJoin_Task_ClosePlan</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="Task_ClosePlan" name="Close care plan"><bpmn:extensionElements><zeebe:taskDefinition type="hh.complete-workflow" retries="3" /><zeebe:ioMapping><zeebe:input source="=workflowId" target="workflowId" /><zeebe:input source="=carePlanId" target="carePlanId" /><zeebe:input source="=planOutcome" target="planOutcome" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Gw_FinalJoin_Task_ClosePlan</bpmn:incoming><bpmn:outgoing>Flow_Task_ClosePlan_End_Completed</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="End_Completed" name="Seven-day plan completed ​"><bpmn:incoming>Flow_Task_ClosePlan_End_Completed</bpmn:incoming></bpmn:endEvent>
