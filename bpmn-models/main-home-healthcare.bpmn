<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_home_healthcare_dispatch" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
<bpmn:process id="home-healthcare-dispatch" name="Home Healthcare Nurse &amp; Pharmacy Dispatch" isExecutable="true"><bpmn:documentation>Seven-day post-operative home-care plan: discharge validation, nearest-nurse dispatch (Distance Matrix REST connector), daily visits (sequential multi-instance), physiotherapy (parallel multi-instance), pharmacy fulfilment (parallel multi-instance call activity), Readmission Risk Intervention sub-process, e-mail/SMS family notifications. Risk flags are workflow support only.</bpmn:documentation>
<bpmn:startEvent id="Start_Discharged" name="Patient discharged ​"><bpmn:outgoing>Flow_Start_Discharged_Task_ValidateDischarge</bpmn:outgoing></bpmn:startEvent>
<bpmn:serviceTask id="Task_ValidateDischarge" name="Validate discharge details"><bpmn:extensionElements><zeebe:taskDefinition type="hh.validate-discharge" retries="3" /><zeebe:ioMapping><zeebe:input source="=workflowId" target="workflowId" /><zeebe:input source="=patientId" target="patientId" /><zeebe:input source="=patientPhone" target="patientPhone" /><zeebe:input source="=familyPhone" target="familyPhone" /><zeebe:input source="=familyEmail" target="familyEmail" /><zeebe:input source="=dischargeDate" target="dischargeDate" /><zeebe:input source="=patientLat" target="patientLat" /><zeebe:input source="=patientLng" target="patientLng" /><zeebe:input source="=prescriptions" target="prescriptions" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Start_Discharged_Task_ValidateDischarge</bpmn:incoming><bpmn:incoming>Flow_Task_CorrectDischarge_Task_ValidateDischarge</bpmn:incoming><bpmn:outgoing>Flow_Task_ValidateDischarge_Gw_DischargeValid</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="Gw_DischargeValid" name="Details valid? ​"><bpmn:incoming>Flow_Task_ValidateDischarge_Gw_DischargeValid</bpmn:incoming><bpmn:outgoing>Flow_Gw_DischargeValid_Task_ApprovePlan</bpmn:outgoing><bpmn:outgoing>Flow_Gw_DischargeValid_Task_CorrectDischarge</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="Task_CorrectDischarge" name="Correct discharge details"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="correct-discharge-form" /><zeebe:assignmentDefinition candidateGroups="coordinators" /><zeebe:ioMapping><zeebe:input source="=patientName" target="patientName" /><zeebe:input source="=validationErrors" target="validationErrors" /><zeebe:input source="=patientPhone" target="patientPhone" /><zeebe:input source="=familyPhone" target="familyPhone" /><zeebe:input source="=familyEmail" target="familyEmail" /><zeebe:input source="=dischargeDate" target="dischargeDate" /><zeebe:output source="=patientPhone" target="patientPhone" /><zeebe:output source="=familyPhone" target="familyPhone" /><zeebe:output source="=familyEmail" target="familyEmail" /><zeebe:output source="=dischargeDate" target="dischargeDate" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Gw_DischargeValid_Task_CorrectDischarge</bpmn:incoming><bpmn:outgoing>Flow_Task_CorrectDischarge_Task_ValidateDischarge</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="Task_ApprovePlan" name="Approve home-care plan"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="approve-plan-form" /><zeebe:assignmentDefinition candidateGroups="admins" /><zeebe:ioMapping><zeebe:input source="=patientName" target="patientName" /><zeebe:input source="=patientMrn" target="patientMrn" /><zeebe:input source="=patientAddress" target="patientAddress" /><zeebe:input source="=surgeryType" target="surgeryType" /><zeebe:input source="=dischargeDate" target="dischargeDate" /><zeebe:input source="=hospital" target="hospital" /><zeebe:input source="=doctorName" target="doctorName" /><zeebe:input source="=familyContactName" target="familyContactName" /><zeebe:input source="=familyPhone" target="familyPhone" /><zeebe:input source="=prescriptions" target="prescriptions" /><zeebe:input source="=physioSessions" target="physioSessions" /><zeebe:input source="=requestedBy" target="requestedBy" /><zeebe:output source="=approvalDecision" target="approvalDecision" /><zeebe:output source="=approvalNotes" target="approvalNotes" /><zeebe:output source="=approvedBy" target="approvedBy" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Gw_DischargeValid_Task_ApprovePlan</bpmn:incoming><bpmn:outgoing>Flow_Task_ApprovePlan_Gw_Approved</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="Gw_Approved" name="Approved? ​"><bpmn:incoming>Flow_Task_ApprovePlan_Gw_Approved</bpmn:incoming><bpmn:outgoing>Flow_Gw_Approved_Task_GenerateCarePlan</bpmn:outgoing><bpmn:outgoing>Flow_Gw_Approved_Task_RejectPlan</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="Task_RejectPlan" name="Record rejection and inform requester"><bpmn:extensionElements><zeebe:taskDefinition type="hh.reject-plan" retries="3" /><zeebe:ioMapping><zeebe:input source="=workflowId" target="workflowId" /><zeebe:input source="=patientId" target="patientId" /><zeebe:input source="=patientName" target="patientName" /><zeebe:input source="=requestedBy" target="requestedBy" /><zeebe:input source="=approvalNotes" target="approvalNotes" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Gw_Approved_Task_RejectPlan</bpmn:incoming><bpmn:outgoing>Flow_Task_RejectPlan_End_PlanRejected</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="End_PlanRejected" name="Plan rejected ​"><bpmn:incoming>Flow_Task_RejectPlan_End_PlanRejected</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="Task_GenerateCarePlan" name="Generate 7-day care plan"><bpmn:extensionElements><zeebe:taskDefinition type="hh.generate-care-plan" retries="3" /><zeebe:ioMapping><zeebe:input source="=workflowId" target="workflowId" /><zeebe:input source="=dischargeDate" target="dischargeDate" /><zeebe:input source="=requiredSkill" target="requiredSkill" /><zeebe:input source="=physioSessions" target="physioSessions" /><zeebe:output source="=carePlanId" target="carePlanId" /><zeebe:output source="=carePlanDays" target="carePlanDays" /><zeebe:output source="=physioSessions" target="physioSessions" /><zeebe:output source="=careStartDate" target="careStartDate" /><zeebe:output source="=careEndDate" target="careEndDate" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Gw_Approved_Task_GenerateCarePlan</bpmn:incoming><bpmn:outgoing>Flow_Task_GenerateCarePlan_Task_FetchNurses</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="Task_FetchNurses" name="Retrieve available nurses"><bpmn:extensionElements><zeebe:taskDefinition type="hh.fetch-available-nurses" retries="3" /><zeebe:ioMapping><zeebe:input source="=workflowId" target="workflowId" /><zeebe:input source="=requiredSkill" target="requiredSkill" /><zeebe:input source="=nurseSearchAttempts" target="nurseSearchAttempts" /><zeebe:output source="=candidateNurses" target="candidateNurses" /><zeebe:output source="=nurseCount" target="nurseCount" /><zeebe:output source="=nurseSearchAttempts" target="nurseSearchAttempts" /><zeebe:output source="=nurseDestinations" target="nurseDestinations" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Task_GenerateCarePlan_Task_FetchNurses</bpmn:incoming><bpmn:outgoing>Flow_Task_FetchNurses_Gw_NursesFound</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="Gw_NursesFound" name="Nurses found? ​"><bpmn:incoming>Flow_Task_FetchNurses_Gw_NursesFound</bpmn:incoming><bpmn:outgoing>Flow_Gw_NursesFound_Task_DistanceMatrix</bpmn:outgoing><bpmn:outgoing>Flow_Gw_NursesFound_Task_ManualNurse</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="Task_DistanceMatrix" name="Get travel times (Google Distance Matrix)" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTgiIGhlaWdodD0iMTgiIHZpZXdCb3g9IjAgMCAxOCAxOCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48Y2lyY2xlIGN4PSI5IiBjeT0iOSIgcj0iOCIgZmlsbD0iIzUwNTU2MiIvPjwvc3ZnPg=="><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="GET" target="method" /><zeebe:input source="{{secrets.DISTANCE_MATRIX_URL}}" target="url" /><zeebe:input source="={&quot;Content-Type&quot;: &quot;application/json&quot;}" target="headers" /><zeebe:input source="={origins: patientLocation, destinations: nurseDestinations, key: &quot;{{secrets.GOOGLE_MAPS_API_KEY}}&quot;, mode: &quot;driving&quot;}" target="queryParameters" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value="={distanceMatrix: response.body, distanceSource: &quot;DISTANCE_MATRIX_API&quot;}" /><zeebe:header key="errorExpression" value="=if is defined(error) then bpmnError(&quot;DISTANCE_API_ERROR&quot;, &quot;Distance Matrix call failed: &quot; + error.message) else null" /><zeebe:header key="retryBackoff" value="PT5S" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_Gw_NursesFound_Task_DistanceMatrix</bpmn:incoming><bpmn:outgoing>Flow_Task_DistanceMatrix_Task_MatchNurse</bpmn:outgoing></bpmn:serviceTask>
<bpmn:boundaryEvent id="Err_DistanceApi" name="Distance API error ​" cancelActivity="true" attachedToRef="Task_DistanceMatrix"><bpmn:outgoing>Flow_Err_DistanceApi_Task_FallbackDistance</bpmn:outgoing><bpmn:errorEventDefinition errorRef="Error_DISTANCE_API_ERROR" /></bpmn:boundaryEvent>
<bpmn:serviceTask id="Task_FallbackDistance" name="Rank nurses by straight-line distance"><bpmn:extensionElements><zeebe:taskDefinition type="hh.rank-nurses-fallback" retries="3" /><zeebe:ioMapping><zeebe:input source="=candidateNurses" target="candidateNurses" /><zeebe:input source="=patientLat" target="patientLat" /><zeebe:input source="=patientLng" target="patientLng" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Err_DistanceApi_Task_FallbackDistance</bpmn:incoming><bpmn:incoming>Flow_Err_DistanceInvalid_Task_FallbackDistance</bpmn:incoming><bpmn:outgoing>Flow_Task_FallbackDistance_Task_MatchNurse</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="Task_MatchNurse" name="Select nearest suitable nurse"><bpmn:extensionElements><zeebe:taskDefinition type="hh.match-nurse" retries="3" /><zeebe:ioMapping><zeebe:input source="=workflowId" target="workflowId" /><zeebe:input source="=candidateNurses" target="candidateNurses" /><zeebe:input source="=distanceMatrix" target="distanceMatrix" /><zeebe:input source="=nurseDistances" target="nurseDistances" /><zeebe:input source="=distanceSource" target="distanceSource" /><zeebe:input source="=maxTravelMinutes" target="maxTravelMinutes" /><zeebe:output source="=nurseDistances" target="nurseDistances" /><zeebe:output source="=selectedNurseId" target="selectedNurseId" /><zeebe:output source="=selectedDistanceMeters" target="selectedDistanceMeters" /><zeebe:output source="=selectedTravelSeconds" target="selectedTravelSeconds" /><zeebe:output source="=assignmentMode" target="assignmentMode" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Task_DistanceMatrix_Task_MatchNurse</bpmn:incoming><bpmn:incoming>Flow_Task_FallbackDistance_Task_MatchNurse</bpmn:incoming><bpmn:outgoing>Flow_Task_MatchNurse_Task_AssignNurse</bpmn:outgoing></bpmn:serviceTask>
<bpmn:boundaryEvent id="Err_DistanceInvalid" name="Unusable response ​" cancelActivity="true" attachedToRef="Task_MatchNurse"><bpmn:outgoing>Flow_Err_DistanceInvalid_Task_FallbackDistance</bpmn:outgoing><bpmn:errorEventDefinition errorRef="Error_DISTANCE_API_ERROR" /></bpmn:boundaryEvent>
<bpmn:boundaryEvent id="Err_NoNurse" name="No suitable nurse ​" cancelActivity="true" attachedToRef="Task_MatchNurse"><bpmn:outgoing>Flow_Err_NoNurse_Task_ManualNurse</bpmn:outgoing><bpmn:errorEventDefinition errorRef="Error_NO_SUITABLE_NURSE" /></bpmn:boundaryEvent>
<bpmn:userTask id="Task_ManualNurse" name="Arrange nurse manually"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="manual-nurse-form" /><zeebe:assignmentDefinition candidateGroups="coordinators" /><zeebe:ioMapping><zeebe:input source="=patientName" target="patientName" /><zeebe:input source="=patientAddress" target="patientAddress" /><zeebe:input source="=requiredSkill" target="requiredSkill" /><zeebe:input source="=nurseDistances" target="nurseDistances" /><zeebe:output source="=selectedNurseId" target="selectedNurseId" /><zeebe:output source="=manualAssignmentNote" target="manualAssignmentNote" /><zeebe:output source="=&quot;MANUAL&quot;" target="assignmentMode" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Gw_NursesFound_Task_ManualNurse</bpmn:incoming><bpmn:incoming>Flow_Err_NoNurse_Task_ManualNurse</bpmn:incoming><bpmn:outgoing>Flow_Task_ManualNurse_Task_AssignNurse</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="Task_AssignNurse" name="Assign nurse"><bpmn:extensionElements><zeebe:taskDefinition type="hh.assign-nurse" retries="3" /><zeebe:ioMapping><zeebe:input source="=workflowId" target="workflowId" /><zeebe:input source="=carePlanId" target="carePlanId" /><zeebe:input source="=selectedNurseId" target="selectedNurseId" /><zeebe:input source="=selectedDistanceMeters" target="selectedDistanceMeters" /><zeebe:input source="=selectedTravelSeconds" target="selectedTravelSeconds" /><zeebe:input source="=distanceSource" target="distanceSource" /><zeebe:input source="=assignmentMode" target="assignmentMode" /><zeebe:input source="=manualAssignmentNote" target="manualAssignmentNote" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Task_ManualNurse_Task_AssignNurse</bpmn:incoming><bpmn:incoming>Flow_Task_MatchNurse_Task_AssignNurse</bpmn:incoming><bpmn:outgoing>Flow_Task_AssignNurse_Task_EmailAssignment</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="Task_EmailAssignment" name="E-mail family: nurse assigned"><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:email:1" retries="3" /><zeebe:ioMapping><zeebe:input source="simple" target="authentication.type" /><zeebe:input source="{{secrets.SMTP_USERNAME}}" target="authentication.username" /><zeebe:input source="{{secrets.SMTP_PASSWORD}}" target="authentication.password" /><zeebe:input source="smtp" target="protocol" /><zeebe:input source="{{secrets.SMTP_HOST}}" target="data.smtpConfig.smtpHost" /><zeebe:input source="{{secrets.SMTP_PORT}}" target="data.smtpConfig.smtpPort" /><zeebe:input source="NONE" target="data.smtpConfig.smtpCryptographicProtocol" /><zeebe:input source="sendEmailSmtp" target="data.smtpActionDiscriminator" /><zeebe:input source="care-team@homecare.example" target="data.smtpAction.from" /><zeebe:input source="=familyEmail" target="data.smtpAction.to" /><zeebe:input source="=&quot;Home-care nurse assigned for &quot; + patientName" target="data.smtpAction.subject" /><zeebe:input source="PLAIN" target="data.smtpAction.contentType" /><zeebe:input source="=&quot;Dear &quot; + familyContactName + &quot;,\n\n&quot; + patientName + &quot; is enrolled in a seven-day home-care plan from &quot; + careStartDate + &quot; to &quot; + careEndDate + &quot;.\n\nAssigned nurse: &quot; + assignmentSummary + &quot;. The nurse will visit every day for the seven days. &quot; + string(count(physioSessions)) + &quot; physiotherapy sessions and &quot; + string(count(prescriptions)) + &quot; medication deliveries are also scheduled.\n\nThis is an automated message from the City Home Care team.&quot;" target="data.smtpAction.body" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value="={familyNotified: true}" /><zeebe:header key="errorExpression" value="=if is defined(error) then bpmnError(&quot;NOTIFICATION_FAILED&quot;, &quot;E-mail failed: &quot; + error.message) else null" /><zeebe:header key="retryBackoff" value="PT5S" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_Task_AssignNurse_Task_EmailAssignment</bpmn:incoming><bpmn:outgoing>Flow_Task_EmailAssignment_Gw_NotifyJoin</bpmn:outgoing></bpmn:serviceTask>
<bpmn:boundaryEvent id="Err_EmailAssign" name="E-mail failed ​" cancelActivity="true" attachedToRef="Task_EmailAssignment"><bpmn:outgoing>Flow_Err_EmailAssign_Task_RecordNotifyFailure</bpmn:outgoing><bpmn:errorEventDefinition errorRef="Error_NOTIFICATION_FAILED" /></bpmn:boundaryEvent>
<bpmn:serviceTask id="Task_RecordNotifyFailure" name="Record failed notification"><bpmn:extensionElements><zeebe:taskDefinition type="hh.record-notification-failure" retries="3" /><zeebe:ioMapping><zeebe:input source="=patientId" target="patientId" /><zeebe:input source="=familyEmail" target="familyEmail" /><zeebe:input source="=familyPhone" target="familyPhone" /><zeebe:input source="=&quot;NURSE_ASSIGNMENT&quot;" target="notificationCategory" /><zeebe:input source="=&quot;Nurse-assignment e-mail could not be delivered&quot;" target="notificationError" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Err_EmailAssign_Task_RecordNotifyFailure</bpmn:incoming><bpmn:outgoing>Flow_Task_RecordNotifyFailure_Gw_NotifyJoin</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="Gw_NotifyJoin" name=""><bpmn:incoming>Flow_Task_EmailAssignment_Gw_NotifyJoin</bpmn:incoming><bpmn:incoming>Flow_Task_RecordNotifyFailure_Gw_NotifyJoin</bpmn:incoming><bpmn:outgoing>Flow_Gw_NotifyJoin_Gw_Fork</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:parallelGateway id="Gw_Fork" name="Start care tracks ​"><bpmn:incoming>Flow_Gw_NotifyJoin_Gw_Fork</bpmn:incoming><bpmn:outgoing>Flow_Gw_Fork_Sub_Physio</bpmn:outgoing><bpmn:outgoing>Flow_Gw_Fork_Call_Pharmacy</bpmn:outgoing><bpmn:outgoing>Flow_Gw_Fork_Sub_DailyVisit</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:subProcess id="Sub_Physio" name="Physiotherapy session (parallel, one per session)"><bpmn:extensionElements><zeebe:ioMapping><zeebe:input source="=null" target="appointmentId" /><zeebe:input source="=null" target="physiotherapist" /><zeebe:input source="=null" target="physioStatus" /><zeebe:input source="=null" target="physioNotes" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Gw_Fork_Sub_Physio</bpmn:incoming><bpmn:outgoing>Flow_Sub_Physio_Gw_Join</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics isSequential="false"><bpmn:extensionElements><zeebe:loopCharacteristics inputCollection="=physioSessions" inputElement="session" outputCollection="physioResults" outputElement="={sessionNo: session.sessionNo, dayNumber: session.dayNumber, appointmentId: appointmentId, status: physioStatus}" /></bpmn:extensionElements></bpmn:multiInstanceLoopCharacteristics><bpmn:startEvent id="Start_Physio" name="Session due ​"><bpmn:outgoing>Flow_Start_Physio_Task_BookPhysio</bpmn:outgoing></bpmn:startEvent>
<bpmn:serviceTask id="Task_BookPhysio" name="Book physiotherapy appointment"><bpmn:extensionElements><zeebe:taskDefinition type="hh.schedule-physio" retries="3" /><zeebe:ioMapping><zeebe:input source="=carePlanId" target="carePlanId" /><zeebe:input source="=session" target="session" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Start_Physio_Task_BookPhysio</bpmn:incoming><bpmn:outgoing>Flow_Task_BookPhysio_Task_PhysioSession</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="Task_PhysioSession" name="Record physiotherapy session"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="physio-session-form" /><zeebe:assignmentDefinition assignee="=physiotherapist" candidateGroups="physiotherapists" /><zeebe:ioMapping><zeebe:input source="=patientName" target="patientName" /><zeebe:input source="=patientAddress" target="patientAddress" /><zeebe:input source="=session" target="session" /><zeebe:input source="=appointmentId" target="appointmentId" /><zeebe:output source="=physioStatus" target="physioStatus" /><zeebe:output source="=physioNotes" target="physioNotes" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Task_BookPhysio_Task_PhysioSession</bpmn:incoming><bpmn:outgoing>Flow_Task_PhysioSession_Task_CompletePhysio</bpmn:outgoing></bpmn:userTask>
<bpmn:boundaryEvent id="Timer_PhysioWindow" name="Window passed ​" cancelActivity="true" attachedToRef="Task_PhysioSession"><bpmn:outgoing>Flow_Timer_PhysioWindow_Task_MissedPhysio</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=physioWindow</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:serviceTask id="Task_MissedPhysio" name="Record missed appointment"><bpmn:extensionElements><zeebe:taskDefinition type="hh.record-missed-physio" retries="3" /><zeebe:ioMapping><zeebe:input source="=patientId" target="patientId" /><zeebe:input source="=appointmentId" target="appointmentId" /><zeebe:input source="=session" target="session" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Timer_PhysioWindow_Task_MissedPhysio</bpmn:incoming><bpmn:outgoing>Flow_Task_MissedPhysio_End_PhysioMissed</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="End_PhysioMissed" name="Session missed ​"><bpmn:incoming>Flow_Task_MissedPhysio_End_PhysioMissed</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="Task_CompletePhysio" name="Save session outcome"><bpmn:extensionElements><zeebe:taskDefinition type="hh.complete-physio" retries="3" /><zeebe:ioMapping><zeebe:input source="=appointmentId" target="appointmentId" /><zeebe:input source="=physioStatus" target="physioStatus" /><zeebe:input source="=physioNotes" target="physioNotes" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Task_PhysioSession_Task_CompletePhysio</bpmn:incoming><bpmn:outgoing>Flow_Task_CompletePhysio_End_Physio</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="End_Physio" name="Session recorded ​"><bpmn:incoming>Flow_Task_CompletePhysio_End_Physio</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_Start_Physio_Task_BookPhysio" name="" sourceRef="Start_Physio" targetRef="Task_BookPhysio"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Task_BookPhysio_Task_PhysioSession" name="" sourceRef="Task_BookPhysio" targetRef="Task_PhysioSession"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Task_PhysioSession_Task_CompletePhysio" name="" sourceRef="Task_PhysioSession" targetRef="Task_CompletePhysio"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Task_CompletePhysio_End_Physio" name="" sourceRef="Task_CompletePhysio" targetRef="End_Physio"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Timer_PhysioWindow_Task_MissedPhysio" name="" sourceRef="Timer_PhysioWindow" targetRef="Task_MissedPhysio"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Task_MissedPhysio_End_PhysioMissed" name="" sourceRef="Task_MissedPhysio" targetRef="End_PhysioMissed"></bpmn:sequenceFlow></bpmn:subProcess>
<bpmn:callActivity id="Call_Pharmacy" name="Pharmacy fulfilment"><bpmn:extensionElements><zeebe:calledElement processId="pharmacy-prescription-fulfillment" propagateAllChildVariables="false" propagateAllParentVariables="false" /><zeebe:ioMapping><zeebe:input source="=workflowId" target="workflowId" /><zeebe:input source="=patientId" target="patientId" /><zeebe:input source="=patientName" target="patientName" /><zeebe:input source="=familyPhone" target="familyPhone" /><zeebe:input source="=patientAddress" target="patientAddress" /><zeebe:input source="=prescription" target="prescription" /><zeebe:input source="=deliveryReminder" target="deliveryReminder" /><zeebe:input source="=deliveryTimeout" target="deliveryTimeout" /><zeebe:input source="=null" target="fulfillmentStatus" /><zeebe:input source="=null" target="deliveryRef" /><zeebe:input source="=null" target="fulfillmentNote" /><zeebe:output source="=fulfillmentStatus" target="fulfillmentStatus" /><zeebe:output source="=deliveryRef" target="deliveryRef" /><zeebe:output source="=fulfillmentNote" target="fulfillmentNote" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Gw_Fork_Call_Pharmacy</bpmn:incoming><bpmn:outgoing>Flow_Call_Pharmacy_Gw_Join</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics isSequential="false"><bpmn:extensionElements><zeebe:loopCharacteristics inputCollection="=prescriptions" inputElement="prescription" outputCollection="pharmacyResults" outputElement="={prescriptionId: prescription.prescriptionId, medication: prescription.medication, status: fulfillmentStatus, deliveryRef: deliveryRef, note: fulfillmentNote}" /></bpmn:extensionElements></bpmn:multiInstanceLoopCharacteristics></bpmn:callActivity>
<bpmn:subProcess id="Sub_DailyVisit" name="Daily home-care visit (sequential, day 1 to 7)"><bpmn:extensionElements><zeebe:ioMapping><zeebe:input source="=null" target="visitId" /><zeebe:input source="=null" target="visitStatus" /><zeebe:input source="=null" target="painScore" /><zeebe:input source="=null" target="temperature" /><zeebe:input source="=null" target="woundRedness" /><zeebe:input source="=null" target="woundDischarge" /><zeebe:input source="=null" target="swelling" /><zeebe:input source="=null" target="nurseNotes" /><zeebe:input source="=null" target="riskLevel" /><zeebe:input source="=null" target="riskReasons" /><zeebe:input source="=null" target="assessmentId" /><zeebe:input source="=null" target="interventionId" /><zeebe:input source="=null" target="interventionStatus" /><zeebe:input source="=null" target="doctorDecision" /><zeebe:input source="=null" target="doctorNotes" /><zeebe:input source="=null" target="doctorReminded" /><zeebe:input source="=null" target="emergencyOutcome" /><zeebe:input source="=null" target="emergencyNotes" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Gw_Fork_Sub_DailyVisit</bpmn:incoming><bpmn:outgoing>Flow_Sub_DailyVisit_Gw_Join</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics isSequential="true"><bpmn:extensionElements><zeebe:loopCharacteristics inputCollection="=carePlanDays" inputElement="careDay" outputCollection="visitResults" outputElement="={day: careDay.day, date: careDay.date, visitId: visitId, visitStatus: visitStatus, riskLevel: riskLevel, interventionStatus: interventionStatus}" /></bpmn:extensionElements></bpmn:multiInstanceLoopCharacteristics><bpmn:startEvent id="Start_Visit" name="Visit day ​"><bpmn:outgoing>Flow_Start_Visit_Task_ScheduleVisit</bpmn:outgoing></bpmn:startEvent>
<bpmn:serviceTask id="Task_ScheduleVisit" name="Schedule daily visit"><bpmn:extensionElements><zeebe:taskDefinition type="hh.schedule-visit" retries="3" /><zeebe:ioMapping><zeebe:input source="=workflowId" target="workflowId" /><zeebe:input source="=carePlanId" target="carePlanId" /><zeebe:input source="=careDay" target="careDay" /><zeebe:input source="=assignedNurse" target="assignedNurse" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Start_Visit_Task_ScheduleVisit</bpmn:incoming><bpmn:outgoing>Flow_Task_ScheduleVisit_Task_HealthAssessment</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="Task_HealthAssessment" name="Home visit and health assessment"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="health-assessment-form" /><zeebe:assignmentDefinition assignee="=assignedNurse.username" candidateGroups="nurses" /><zeebe:ioMapping><zeebe:input source="=patientName" target="patientName" /><zeebe:input source="=patientAddress" target="patientAddress" /><zeebe:input source="=careDay" target="careDay" /><zeebe:input source="=visitId" target="visitId" /><zeebe:input source="=surgeryType" target="surgeryType" /><zeebe:output source="=visitStatus" target="visitStatus" /><zeebe:output source="=painScore" target="painScore" /><zeebe:output source="=temperature" target="temperature" /><zeebe:output source="=woundRedness" target="woundRedness" /><zeebe:output source="=woundDischarge" target="woundDischarge" /><zeebe:output source="=swelling" target="swelling" /><zeebe:output source="=nurseNotes" target="nurseNotes" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Task_ScheduleVisit_Task_HealthAssessment</bpmn:incoming><bpmn:outgoing>Flow_Task_HealthAssessment_Gw_VisitDone</bpmn:outgoing></bpmn:userTask>
<bpmn:boundaryEvent id="Timer_VisitWindow" name="Visit window passed ​" cancelActivity="true" attachedToRef="Task_HealthAssessment"><bpmn:outgoing>Flow_Timer_VisitWindow_Task_MissedVisit</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=visitWindow</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:serviceTask id="Task_MissedVisit" name="Record missed visit"><bpmn:extensionElements><zeebe:taskDefinition type="hh.record-missed-visit" retries="3" /><zeebe:ioMapping><zeebe:input source="=patientId" target="patientId" /><zeebe:input source="=visitId" target="visitId" /><zeebe:input source="=careDay" target="careDay" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Timer_VisitWindow_Task_MissedVisit</bpmn:incoming><bpmn:outgoing>Flow_Task_MissedVisit_End_VisitMissed</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="End_VisitMissed" name="Visit missed ​"><bpmn:incoming>Flow_Task_MissedVisit_End_VisitMissed</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="Gw_VisitDone" name="Visit completed? ​"><bpmn:incoming>Flow_Task_HealthAssessment_Gw_VisitDone</bpmn:incoming><bpmn:outgoing>Flow_Gw_VisitDone_Task_EvaluateRisk</bpmn:outgoing><bpmn:outgoing>Flow_Gw_VisitDone_Task_IncompleteVisit</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="Task_IncompleteVisit" name="Record incomplete visit"><bpmn:extensionElements><zeebe:taskDefinition type="hh.record-incomplete-visit" retries="3" /><zeebe:ioMapping><zeebe:input source="=patientId" target="patientId" /><zeebe:input source="=visitId" target="visitId" /><zeebe:input source="=careDay" target="careDay" /><zeebe:input source="=nurseNotes" target="nurseNotes" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Gw_VisitDone_Task_IncompleteVisit</bpmn:incoming><bpmn:outgoing>Flow_Task_IncompleteVisit_End_VisitIncomplete</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="End_VisitIncomplete" name="Follow-up arranged ​"><bpmn:incoming>Flow_Task_IncompleteVisit_End_VisitIncomplete</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="Task_EvaluateRisk" name="Evaluate readmission risk"><bpmn:extensionElements><zeebe:taskDefinition type="hh.evaluate-risk" retries="3" /><zeebe:ioMapping><zeebe:input source="=workflowId" target="workflowId" /><zeebe:input source="=visitId" target="visitId" /><zeebe:input source="=careDay" target="careDay" /><zeebe:input source="=painScore" target="painScore" /><zeebe:input source="=temperature" target="temperature" /><zeebe:input source="=woundRedness" target="woundRedness" /><zeebe:input source="=woundDischarge" target="woundDischarge" /><zeebe:input source="=swelling" target="swelling" /><zeebe:input source="=nurseNotes" target="nurseNotes" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Gw_VisitDone_Task_EvaluateRisk</bpmn:incoming><bpmn:outgoing>Flow_Task_EvaluateRisk_Gw_Risk</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="Gw_Risk" name="Risk level? ​"><bpmn:incoming>Flow_Task_EvaluateRisk_Gw_Risk</bpmn:incoming><bpmn:outgoing>Flow_Gw_Risk_End_VisitNormal</bpmn:outgoing><bpmn:outgoing>Flow_Gw_Risk_Sub_RiskIntervention</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="End_VisitNormal" name="Visit done, normal risk ​"><bpmn:incoming>Flow_Gw_Risk_End_VisitNormal</bpmn:incoming></bpmn:endEvent>
<bpmn:subProcess id="Sub_RiskIntervention" name="Readmission Risk Intervention"><bpmn:incoming>Flow_Gw_Risk_Sub_RiskIntervention</bpmn:incoming><bpmn:outgoing>Flow_Sub_RiskIntervention_End_Intervened</bpmn:outgoing><bpmn:startEvent id="Start_Risk" name="High pain or infection reported ​"><bpmn:outgoing>Flow_Start_Risk_Task_OpenIntervention</bpmn:outgoing></bpmn:startEvent>
<bpmn:serviceTask id="Task_OpenIntervention" name="Open intervention and alert doctor"><bpmn:extensionElements><zeebe:taskDefinition type="hh.open-intervention" retries="3" /><zeebe:ioMapping><zeebe:input source="=workflowId" target="workflowId" /><zeebe:input source="=patientId" target="patientId" /><zeebe:input source="=patientName" target="patientName" /><zeebe:input source="=assessmentId" target="assessmentId" /><zeebe:input source="=riskLevel" target="riskLevel" /><zeebe:input source="=riskReasons" target="riskReasons" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Start_Risk_Task_OpenIntervention</bpmn:incoming><bpmn:outgoing>Flow_Task_OpenIntervention_Gw_Severity</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="Gw_Severity" name="Severity? ​"><bpmn:incoming>Flow_Task_OpenIntervention_Gw_Severity</bpmn:incoming><bpmn:outgoing>Flow_Gw_Severity_Task_DispatchEmergency</bpmn:outgoing><bpmn:outgoing>Flow_Gw_Severity_Task_DoctorReview</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="Task_DispatchEmergency" name="Dispatch urgent response"><bpmn:extensionElements><zeebe:taskDefinition type="hh.dispatch-emergency" retries="3" /><zeebe:ioMapping><zeebe:input source="=interventionId" target="interventionId" /><zeebe:input source="=patientAddress" target="patientAddress" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Gw_Severity_Task_DispatchEmergency</bpmn:incoming><bpmn:outgoing>Flow_Task_DispatchEmergency_Task_SmsCritical</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="Task_SmsCritical" name="SMS family: critical alert" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTgiIGhlaWdodD0iMTgiIHZpZXdCb3g9IjAgMCAxOCAxOCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48Y2lyY2xlIGN4PSI5IiBjeT0iOSIgcj0iOCIgZmlsbD0iIzUwNTU2MiIvPjwvc3ZnPg=="><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="bearer" target="authentication.type" /><zeebe:input source="{{secrets.SMS_API_KEY}}" target="authentication.token" /><zeebe:input source="POST" target="method" /><zeebe:input source="{{secrets.SMS_GATEWAY_URL}}" target="url" /><zeebe:input source="={&quot;Content-Type&quot;: &quot;application/json&quot;}" target="headers" /><zeebe:input source="={to: familyPhone, category: &quot;CRITICAL_ALERT&quot;, message: &quot;URGENT: &quot; + patientName + &quot; needs urgent clinical attention. An urgent response team has been dispatched and the care team will call you.&quot;}" target="body" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value="={criticalAlertSid: response.body.sid}" /><zeebe:header key="retryBackoff" value="PT5S" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_Task_DispatchEmergency_Task_SmsCritical</bpmn:incoming><bpmn:outgoing>Flow_Task_SmsCritical_Gw_RiskJoin</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="Task_DoctorReview" name="Doctor review"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="doctor-review-form" /><zeebe:assignmentDefinition candidateGroups="doctors" /><zeebe:ioMapping><zeebe:input source="=patientName" target="patientName" /><zeebe:input source="=careDay" target="careDay" /><zeebe:input source="=riskLevel" target="riskLevel" /><zeebe:input source="=riskReasons" target="riskReasons" /><zeebe:input source="=painScore" target="painScore" /><zeebe:input source="=temperature" target="temperature" /><zeebe:input source="=nurseNotes" target="nurseNotes" /><zeebe:input source="=interventionId" target="interventionId" /><zeebe:output source="=doctorDecision" target="doctorDecision" /><zeebe:output source="=doctorNotes" target="doctorNotes" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Gw_Severity_Task_DoctorReview</bpmn:incoming><bpmn:outgoing>Flow_Task_DoctorReview_Gw_Decision</bpmn:outgoing></bpmn:userTask>
<bpmn:boundaryEvent id="Timer_DoctorReminder" name="Reminder ​" cancelActivity="false" attachedToRef="Task_DoctorReview"><bpmn:outgoing>Flow_Timer_DoctorReminder_Task_RemindDoctor</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=doctorReviewReminder</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:serviceTask id="Task_RemindDoctor" name="Remind on-call doctor"><bpmn:extensionElements><zeebe:taskDefinition type="hh.remind-doctor" retries="3" /><zeebe:ioMapping><zeebe:input source="=patientId" target="patientId" /><zeebe:input source="=interventionId" target="interventionId" /><zeebe:input source="=patientName" target="patientName" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Timer_DoctorReminder_Task_RemindDoctor</bpmn:incoming><bpmn:outgoing>Flow_Task_RemindDoctor_End_Reminded</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="End_Reminded" name="Reminder sent ​"><bpmn:incoming>Flow_Task_RemindDoctor_End_Reminded</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="Gw_Decision" name="Doctor decision? ​"><bpmn:incoming>Flow_Task_DoctorReview_Gw_Decision</bpmn:incoming><bpmn:outgoing>Flow_Gw_Decision_Gw_RiskJoin</bpmn:outgoing><bpmn:outgoing>Flow_Gw_Decision_Task_Readmit</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="Task_Readmit" name="Arrange hospital readmission"><bpmn:extensionElements><zeebe:taskDefinition type="hh.arrange-readmission" retries="3" /><zeebe:ioMapping><zeebe:input source="=workflowId" target="workflowId" /><zeebe:input source="=patientId" target="patientId" /><zeebe:input source="=interventionId" target="interventionId" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Gw_Decision_Task_Readmit</bpmn:incoming><bpmn:outgoing>Flow_Task_Readmit_Task_CloseIntervention</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="Gw_RiskJoin" name=""><bpmn:incoming>Flow_Task_SmsCritical_Gw_RiskJoin</bpmn:incoming><bpmn:incoming>Flow_Gw_Decision_Gw_RiskJoin</bpmn:incoming><bpmn:outgoing>Flow_Gw_RiskJoin_Task_CloseIntervention</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="Task_CloseIntervention" name="Close intervention"><bpmn:extensionElements><zeebe:taskDefinition type="hh.close-intervention" retries="3" /><zeebe:ioMapping><zeebe:input source="=interventionId" target="interventionId" /><zeebe:input source="=riskLevel" target="riskLevel" /><zeebe:input source="=doctorDecision" target="doctorDecision" /><zeebe:input source="=doctorNotes" target="doctorNotes" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Task_Readmit_Task_CloseIntervention</bpmn:incoming><bpmn:incoming>Flow_Gw_RiskJoin_Task_CloseIntervention</bpmn:incoming><bpmn:outgoing>Flow_Task_CloseIntervention_End_Risk</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="End_Risk" name="Intervention closed ​"><bpmn:incoming>Flow_Task_CloseIntervention_End_Risk</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_Start_Risk_Task_OpenIntervention" name="" sourceRef="Start_Risk" targetRef="Task_OpenIntervention"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Task_OpenIntervention_Gw_Severity" name="" sourceRef="Task_OpenIntervention" targetRef="Gw_Severity"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Gw_Severity_Task_DispatchEmergency" name="CRITICAL ​" sourceRef="Gw_Severity" targetRef="Task_DispatchEmergency"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=riskLevel = &quot;CRITICAL&quot;</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Gw_Severity_Task_DoctorReview" name="ELEVATED ​" sourceRef="Gw_Severity" targetRef="Task_DoctorReview"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=riskLevel = &quot;ELEVATED&quot;</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Task_DispatchEmergency_Task_SmsCritical" name="" sourceRef="Task_DispatchEmergency" targetRef="Task_SmsCritical"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Task_SmsCritical_Gw_RiskJoin" name="" sourceRef="Task_SmsCritical" targetRef="Gw_RiskJoin"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Task_DoctorReview_Gw_Decision" name="" sourceRef="Task_DoctorReview" targetRef="Gw_Decision"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Timer_DoctorReminder_Task_RemindDoctor" name="" sourceRef="Timer_DoctorReminder" targetRef="Task_RemindDoctor"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Task_RemindDoctor_End_Reminded" name="" sourceRef="Task_RemindDoctor" targetRef="End_Reminded"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Gw_Decision_Gw_RiskJoin" name="Home care / urgent visit ​" sourceRef="Gw_Decision" targetRef="Gw_RiskJoin"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=doctorDecision = &quot;HOME_CARE&quot; or doctorDecision = &quot;URGENT_VISIT&quot;</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Gw_Decision_Task_Readmit" name="Readmit ​" sourceRef="Gw_Decision" targetRef="Task_Readmit"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=doctorDecision = &quot;READMIT&quot;</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Task_Readmit_Task_CloseIntervention" name="" sourceRef="Task_Readmit" targetRef="Task_CloseIntervention"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Gw_RiskJoin_Task_CloseIntervention" name="" sourceRef="Gw_RiskJoin" targetRef="Task_CloseIntervention"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Task_CloseIntervention_End_Risk" name="" sourceRef="Task_CloseIntervention" targetRef="End_Risk"></bpmn:sequenceFlow></bpmn:subProcess>
<bpmn:boundaryEvent id="Err_EmergencyDispatch" name="Emergency dispatch failed ​" cancelActivity="true" attachedToRef="Sub_RiskIntervention"><bpmn:outgoing>Flow_Err_EmergencyDispatch_Task_ManualEmergency</bpmn:outgoing><bpmn:errorEventDefinition errorRef="Error_EMERGENCY_DISPATCH_FAILED" /></bpmn:boundaryEvent>
<bpmn:boundaryEvent id="Timer_InterventionTimeout" name="Intervention timed out ​" cancelActivity="true" attachedToRef="Sub_RiskIntervention"><bpmn:outgoing>Flow_Timer_InterventionTimeout_Task_ClinicalLead</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=interventionTimeout</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:userTask id="Task_ManualEmergency" name="Coordinate emergency manually"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="manual-emergency-form" /><zeebe:assignmentDefinition candidateGroups="coordinators" /><zeebe:ioMapping><zeebe:input source="=patientName" target="patientName" /><zeebe:input source="=patientAddress" target="patientAddress" /><zeebe:input source="=patientPhone" target="patientPhone" /><zeebe:input source="=familyPhone" target="familyPhone" /><zeebe:input source="=riskReasons" target="riskReasons" /><zeebe:input source="=interventionId" target="interventionId" /><zeebe:output source="=emergencyOutcome" target="emergencyOutcome" /><zeebe:output source="=emergencyNotes" target="emergencyNotes" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Err_EmergencyDispatch_Task_ManualEmergency</bpmn:incoming><bpmn:outgoing>Flow_Task_ManualEmergency_Task_RecordEscalation</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="Task_RecordEscalation" name="Record manual escalation"><bpmn:extensionElements><zeebe:taskDefinition type="hh.record-escalation" retries="3" /><zeebe:ioMapping><zeebe:input source="=interventionId" target="interventionId" /><zeebe:input source="=emergencyOutcome" target="emergencyOutcome" /><zeebe:input source="=emergencyNotes" target="emergencyNotes" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Task_ManualEmergency_Task_RecordEscalation</bpmn:incoming><bpmn:outgoing>Flow_Task_RecordEscalation_End_Escalated</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="End_Escalated" name="Escalation recorded ​"><bpmn:incoming>Flow_Task_RecordEscalation_End_Escalated</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="Task_ClinicalLead" name="Escalate to clinical lead"><bpmn:extensionElements><zeebe:taskDefinition type="hh.escalate-clinical-lead" retries="3" /><zeebe:ioMapping><zeebe:input source="=patientId" target="patientId" /><zeebe:input source="=interventionId" target="interventionId" /><zeebe:input source="=patientName" target="patientName" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Timer_InterventionTimeout_Task_ClinicalLead</bpmn:incoming><bpmn:outgoing>Flow_Task_ClinicalLead_End_LeadEscalated</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="End_LeadEscalated" name="Clinical lead notified ​"><bpmn:incoming>Flow_Task_ClinicalLead_End_LeadEscalated</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="End_Intervened" name="Visit done, intervention closed ​"><bpmn:incoming>Flow_Sub_RiskIntervention_End_Intervened</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_Start_Visit_Task_ScheduleVisit" name="" sourceRef="Start_Visit" targetRef="Task_ScheduleVisit"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Task_ScheduleVisit_Task_HealthAssessment" name="" sourceRef="Task_ScheduleVisit" targetRef="Task_HealthAssessment"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Task_HealthAssessment_Gw_VisitDone" name="" sourceRef="Task_HealthAssessment" targetRef="Gw_VisitDone"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Timer_VisitWindow_Task_MissedVisit" name="" sourceRef="Timer_VisitWindow" targetRef="Task_MissedVisit"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Task_MissedVisit_End_VisitMissed" name="" sourceRef="Task_MissedVisit" targetRef="End_VisitMissed"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Gw_VisitDone_Task_EvaluateRisk" name="Done ​" sourceRef="Gw_VisitDone" targetRef="Task_EvaluateRisk"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=visitStatus = &quot;COMPLETED&quot;</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Gw_VisitDone_Task_IncompleteVisit" name="Incomplete ​" sourceRef="Gw_VisitDone" targetRef="Task_IncompleteVisit"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=visitStatus = &quot;INCOMPLETE&quot;</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Task_IncompleteVisit_End_VisitIncomplete" name="" sourceRef="Task_IncompleteVisit" targetRef="End_VisitIncomplete"></bpmn:sequenceFlow>
