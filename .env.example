# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# ---- PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/homecare
DB_USERNAME=homecare
DB_PASSWORD=change-me
POSTGRES_PASSWORD=change-me

# ---- Camunda 8 (local Camunda 8 Run by default)
CAMUNDA_GRPC_ADDRESS=http://localhost:26500
CAMUNDA_REST_ADDRESS=http://localhost:8080

# ---- Connector secrets (read by the Camunda connector runtime as {{secrets.NAME}})
# Demo mode: the URLs point at the backend's mock endpoints. Live mode: real providers.
DISTANCE_MATRIX_URL=http://localhost:8090/mock/google/maps/api/distancematrix/json
# Live: DISTANCE_MATRIX_URL=https://maps.googleapis.com/maps/api/distancematrix/json
GOOGLE_MAPS_API_KEY=demo-google-key
SMS_GATEWAY_URL=http://localhost:8090/mock/sms/messages
SMS_API_KEY=demo-sms-key
SMTP_HOST=localhost
SMTP_PORT=3025
SMTP_USERNAME=hh-notify
SMTP_PASSWORD=change-me

# ---- Backend behaviour
HOMECARE_DEMO_MODE=true
MAIL_EMBEDDED_SERVER=true

# ---- Portal logins (ADMIN approves, USER submits requests)
APP_ADMIN_PASSWORD=change-me-admin
APP_USER_PASSWORD=change-me-user
